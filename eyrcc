import math

###### GLOBAL VARIABLES ######
reference_frame = None
front_motor = None
drive_motor = None
front_s = left_s = right_s = None

tilt = 0.0
tilt_dot = 0.0
yaw = 0.0
yaw_dot = 0.0
yaw_setpoint = 0.0
yaw_target = 0.0

U = 0.0
dt = 0.01

MOTOR_SIGN = +1
YAW_LIMIT = 0.45
K = [-19.3768, -180.4344, 45.5536, 45.0]
DRIVE_SIGN = -1

# ------------------------------ TRACK PLAN ----------------------------------
# One entry per turn, in order, in degrees.  +ve = LEFT, -ve = RIGHT
# (same sign convention as your 3A script: right turn = negative yaw).
# From the top-view diagram: start heading "east", then
#   90L, 45L, 90L, 90L, 45L, 90R, 90R, 45R, 90R, 90L, 45L  -> goal (west)
TURNS = [+90, +45, +90, +90, +45, -90, -90, -45, -90, +90, +45]

# ------------------------------ TUNING KNOBS --------------------------------
CRUISE        = 27     # wheel rad/s on straights (lower it if tilt RMS is high)
ACCEL         = 18
BRAKE         = 20
BRAKE_PLAN    = 12     # planned decel while approaching a wall
TURN_SPEED    = 3.0    # wheel rad/s during turns (proven slow value)
TURN_SPEED_45 = 3.0    # same by default; try 4-5 once 90s are clean
D_TURN        = 0.25   # m, front distance that starts a 90 deg turn
D_TURN_45     = 0.25   # m, front distance that starts a 45 deg turn
YAW_RATE      = 1.5    # rad/s setpoint sweep
WHEEL_R       = 0.0167
TURN_TOL      = 0.12
TURN_COOLDOWN = 0.5    # was 1.5 s -> big time saver on short segments
FINAL_SPEED   = 10.0   # cap on the last straight (it is short)
STOP_DECEL    = 4.0    # was 2.5 -> stops in ~2.5 s instead of ~10 s
FINISH_HOLD   = 0.3
CENTER_GAIN   = 0.0    # >0 enables centring from (L - R); e.g. 0.3
PRINT_EVERY   = 0.0    # 0 = no periodic spam; set 0.5 to debug

state = "STRAIGHT"
turn_idx = 0
speed_cmd = 0.0
t_state = 0.0
t_open = None
last_print = 0.0
front_dist = None
tilt_sq_sum = 0.0
tilt_n = 0
t_done = None
reported = False


def wrap_to_pi(angle):
    return (angle + math.pi) % (2.0 * math.pi) - math.pi


def clamp(value, limit):
    return max(-limit, min(limit, value))


def slew(current, target, step):
    return current + clamp(target - current, step)


def read(s):
    r, d, *_ = sim.readProximitySensor(s)
    if r == 1:
        return d
    return None


def fmt(v):
    if v is None:
        return "None"
    return "%.2f" % v


def get_sensor(name):
    try:
        return sim.getObject('/' + name)
    except Exception:
        return sim.getObject('/reference_frame/spherical_joint/bike_respondable/' + name)


def bike_tilt_yaw():
    m = sim.getObjectMatrix(drive_motor, reference_frame)
    axle = [m[2], m[6], m[10]]
    front = sim.getObjectPosition(front_motor, reference_frame)
    rear = sim.getObjectPosition(drive_motor, reference_frame)
    forward = [front[i] - rear[i] for i in range(3)]
    length = math.sqrt(sum(v * v for v in forward))
    forward = [v / length for v in forward]
    up_z = axle[0] * forward[1] - axle[1] * forward[0]
    t = math.atan2(-axle[2], up_z)
    y = math.atan2(-forward[0], forward[1])
    return t, y


def set_state(new_state):
    global state, t_state
    state = new_state
    t_state = sim.getSimulationTime()


def cur_turn_is_45():
    return turn_idx < len(TURNS) and abs(TURNS[turn_idx]) < 60


def debug_print(now, f, l, r):
    global last_print
    if PRINT_EVERY <= 0:
        return
    if now - last_print < PRINT_EVERY:
        return
    last_print = now
    wv = DRIVE_SIGN * sim.getJointVelocity(drive_motor)
    print("t=%6.2f %-8s n=%d F=%s L=%s R=%s yaw=%+.2f sp=%+.2f tilt=%+.3f v=%.2f wv=%+.2f" %
          (now, state, turn_idx, fmt(f), fmt(l), fmt(r), yaw, yaw_setpoint, tilt, speed_cmd, wv))


##############################


def sysCall_init():
    global sim
    sim = require('sim')

    ####### WRITE YOUR LOGIC HERE ######
    global reference_frame, front_motor, drive_motor, front_s, left_s, right_s
    global dt, tilt, yaw, yaw_setpoint, yaw_target, speed_cmd
    global state, t_state, t_open, last_print, front_dist
    global turn_idx, tilt_sq_sum, tilt_n, t_done, reported

    reference_frame = sim.getObject('/reference_frame')
    front_motor = sim.getObject('/reference_frame/spherical_joint/bike_respondable/front_motor')
    drive_motor = sim.getObject('/reference_frame/spherical_joint/bike_respondable/drive_motor')
    front_s = get_sensor('FrontSensor')
    left_s = get_sensor('LeftSensor')
    right_s = get_sensor('RightSensor')

    dt = sim.getSimulationTimeStep()
    tilt, yaw = bike_tilt_yaw()

    # All turns are relative to the heading the bike starts with.
    yaw_setpoint = yaw
    yaw_target = yaw
    speed_cmd = 0.0
    t_open = None
    last_print = 0.0
    front_dist = None
    turn_idx = 0
    tilt_sq_sum = 0.0
    tilt_n = 0
    t_done = None
    reported = False
    state = "STRAIGHT"
    t_state = 0.0
    ####################################


def sysCall_sensing():
    ####### WRITE YOUR LOGIC HERE ######
    global tilt, tilt_dot, yaw, yaw_dot, yaw_target, t_open, front_dist
    global turn_idx, tilt_sq_sum, tilt_n, t_done, reported

    new_tilt, new_yaw = bike_tilt_yaw()
    tilt_dot = (new_tilt - tilt) / dt
    yaw_dot = wrap_to_pi(new_yaw - yaw) / dt
    tilt = new_tilt
    yaw = new_yaw

    now = sim.getSimulationTime()
    if state != "DONE":
        tilt_sq_sum += tilt * tilt
        tilt_n += 1

    f = read(front_s)
    l = read(left_s)
    r = read(right_s)
    front_dist = f
    settled = (now - t_state) > TURN_COOLDOWN

    if state == "STRAIGHT":
        if turn_idx < len(TURNS):
            d_trig = D_TURN_45 if cur_turn_is_45() else D_TURN
            if settled and f is not None and f < d_trig:
                yaw_target += math.radians(TURNS[turn_idx])
                set_state("TURN")
        else:
            # final straight: stop once both side walls are gone (exit reached)
            if settled and l is None and r is None:
                if t_open is None:
                    t_open = now
                elif now - t_open > FINISH_HOLD:
                    set_state("STOPPING")
            else:
                t_open = None
            if settled and f is not None and f < 0.15:
                set_state("STOPPING")

    elif state == "TURN":
        done = abs(wrap_to_pi(yaw - yaw_target)) < TURN_TOL
        if done and abs(yaw_setpoint - yaw_target) < 1e-3:
            turn_idx += 1
            set_state("STRAIGHT")

    elif state == "STOPPING":
        if abs(speed_cmd) < 1e-3:
            set_state("DONE")
            t_done = now

    if state == "DONE" and not reported and tilt_n > 0:
        reported = True
        rms_deg = math.degrees(math.sqrt(tilt_sq_sum / tilt_n))
        est = 40.0 * (1200.0 - t_done) / 1200.0 + max(0.0, 1.0 - rms_deg / 10.0) * 10.0
        print("DONE  ts=%.1fs  tilt_rms=%.2fdeg  score(before wall penalties)=%.2f" %
              (t_done, rms_deg, est))

    debug_print(now, f, l, r)
    ####################################


def sysCall_actuation():
    ####### WRITE YOUR LOGIC HERE ######
    global U, yaw_setpoint, speed_cmd

    yaw_setpoint = slew(yaw_setpoint, yaw_target, YAW_RATE * dt)

    trim = 0.0
    if CENTER_GAIN != 0.0 and state == "STRAIGHT":
        l = read(left_s)
        r = read(right_s)
        if l is not None and r is not None:
            trim = clamp(CENTER_GAIN * (l - r), 0.15)
    sp = yaw_setpoint + trim

    yaw_offset = clamp(wrap_to_pi(yaw - sp), YAW_LIMIT)
    U = -(K[0] * tilt_dot + K[1] * tilt + K[2] * yaw_dot + K[3] * yaw_offset)
    sim.setJointTargetVelocity(front_motor, MOTOR_SIGN * U)

    if state == "STRAIGHT":
        if turn_idx < len(TURNS):
            d_trig = D_TURN_45 if cur_turn_is_45() else D_TURN
            ts_next = TURN_SPEED_45 if cur_turn_is_45() else TURN_SPEED
            if front_dist is not None:
                # distance-based approach: reach turn speed right at the trigger distance
                d = max(front_dist - d_trig, 0.0)
                plan = math.sqrt(ts_next ** 2 + 2.0 * BRAKE_PLAN * d / WHEEL_R)
                target = max(ts_next, min(CRUISE, plan))
            else:
                target = CRUISE
        else:
            target = min(CRUISE, FINAL_SPEED)
    elif state == "TURN":
        target = TURN_SPEED_45 if abs(TURNS[min(turn_idx, len(TURNS) - 1)]) < 60 else TURN_SPEED
    else:
        target = 0.0

    if state in ("STOPPING", "DONE"):
        rate = STOP_DECEL
    elif target > speed_cmd:
        rate = ACCEL
    else:
        rate = BRAKE

    speed_cmd = slew(speed_cmd, target, rate * dt)
    sim.setJointTargetVelocity(drive_motor, DRIVE_SIGN * speed_cmd)
    ####################################


def sysCall_cleanup():
    ####### WRITE YOUR LOGIC HERE ######
    sim.setJointTargetVelocity(front_motor, 0)
    sim.setJointTargetVelocity(drive_motor, 0)
    ####################################
